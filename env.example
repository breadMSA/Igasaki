# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# CharacterAI Token (可選)
CHARACTERAI_TOKEN=your_characterai_token_here

# Chat Proxy URL (可選)
CHAT_PROXY_URL=your_chat_proxy_url_here

# Memory API Key for BAAI/bge-m3 vector search
MEMORY_API_KEY=your_memory_api_key_here

# Character.AI 直接整合設定（請確保你具有合法授權並遵守相關服務條款）
CHARACTERAI_CHARACTER_ID=your_character_id_here
CHARACTERAI_CHAT_ID=your_existing_chat_id_here

# 外部聊天代理設定（後備方案）
CHAT_PROXY_API_KEY=your_proxy_api_key_if_needed
CHAT_PROXY_CHAT_PATH=/v1/chat
CHAT_PROXY_VOICE_ID=default_voice_id

# TTS 設定
TTS_MODE=characterai
TTS_FORMAT=mp3

# 安全設定
SAFETY_ENABLE_HARDBLOCK=true
SAFETY_CLASSIFY_WITH_GEMINI=true
LOG_SENSITIVE_TEXTS=false

# 開發設定
PORT=3001
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# CORS 設定
CORS_ORIGIN=http://localhost:5173

# 聲音模板設定（可選覆寫）
TTS_SYSTEM_PROMPT=你是一個純語音輸出器。請用自然、清晰、溫柔的女性聲線，逐字朗讀我提供的內容。不要添加任何額外字詞、解釋或助詞；不要輸出文字，僅輸出語音。內容若含引號，忽略引號本身，只朗讀其內文。
TTS_USER_TEMPLATE=請朗讀以下內容，不要多說任何一句話：{{TEXT}}
